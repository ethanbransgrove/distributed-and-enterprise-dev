    {
      "text": "**FUNCTIONALITY 2 / PRODUCER FORM 1**\n\n# Update inventory and seasonal availability\n\nEnter the new total stock and availability dates for an existing published product.\n\n\\* Required field",
      "type": "text",
      "layout": {
        "row": "Row_0i4a56v",
        "columns": null
      },
      "id": "Field_04h1a8o"
    },
    {
      "label": "Product ID",
      "type": "textfield",
      "layout": {
        "row": "Row_1da4n5s",
        "columns": null
      },
      "id": "Field_1intba9",
      "key": "textfield_oq64wa",
      "description": "Enter the unique identifier of the existing product.",
      "validate": {
        "required": true
      }
    },
    {
      "label": "New stock quantity",
      "type": "number",
      "layout": {

      },
      "id": "Field_0sfr9ly",
      "key": "number_qyo7kp",
      "description": "Enter the total units available after this update. Enter 0 if sold out.",
      "decimalDigits": 0,
      "increment": "1",
      "validate": {
        "required": true,
        "min": "0"
      }
    },
    {
